generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  firstName String
  lastName  String
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  roles UserRole[]
  assignedIncidents Incident[] @relation("AssignedIncidents")
  createdIncidents  Incident[] @relation("CreatedIncidents")

  @@map("users")
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  resource    String
  action      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssetType {
  SERVER
  WORKSTATION
  LAPTOP
  FIREWALL
  SWITCH
  ROUTER
  CLOUD_VM
  DATABASE
  OTHER
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssetStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

model Incident {
  id          String           @id @default(cuid())
  title       String
  description String
  status      IncidentStatus   @default(OPEN)
  severity    IncidentSeverity @default(MEDIUM)
  assignedTo  String?
  assignedUser User?           @relation("AssignedIncidents", fields: [assignedTo], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User             @relation("CreatedIncidents", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  assets IncidentAsset[]

  @@index([status])
  @@index([severity])
  @@index([assignedTo])
  @@index([createdAt])
  @@index([title, description])
  @@map("incidents")
}

model Asset {
  id              String      @id @default(cuid())
  assetName       String
  hostname        String?
  ipAddress       String?
  assetType       AssetType   @default(OTHER)
  operatingSystem String?
  owner           String?
  department      String?
  criticality     Criticality @default(MEDIUM)
  status          AssetStatus @default(ACTIVE)
  location        String?
  description     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  incidents IncidentAsset[]

  @@index([assetName])
  @@index([assetType])
  @@index([status])
  @@index([criticality])
  @@map("assets")
}

model Settings {
  id                    String   @id @default(cuid())
  organizationName      String   @default("")
  companyName           String?
  industry              String?
  website               String?
  email                 String?
  phone                 String?
  timeZone              String?  @default("UTC")
  address               String?
  logoUrl               String?
  primaryColor          String?  @default("#2563eb")
  accentColor           String?  @default("#7c3aed")
  applicationName       String?  @default("SentinelX")
  passwordMinLength     Int      @default(12)
  requireUppercase      Boolean  @default(true)
  requireNumbers        Boolean  @default(true)
  requireSymbols        Boolean  @default(true)
  sessionTimeoutMinutes Int      @default(60)
  mfaEnabled            Boolean  @default(false)
  emailNotifications    Boolean  @default(true)
  browserNotifications  Boolean  @default(true)
  criticalAlerts        Boolean  @default(true)
  dailySummaryEmails    Boolean  @default(false)
  theme                 String   @default("system")
  sidebarCollapsed      Boolean  @default(false)
  compactMode           Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("settings")
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String
  severity  String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  userId    String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  userName    String   @map("user_name")
  action      String
  resource    String
  resourceId  String?  @map("resource_id")
  description String?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  severity    String   @default("Info")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action, createdAt])
  @@index([severity])
  @@map("audit_logs")
}

model IncidentAsset {
  incidentId String
  assetId    String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([incidentId, assetId])
  @@map("incident_assets")
}
