# Server
NODE_ENV=development
PORT=5000
API_VERSION=1.0.0

# Database
DATABASE_URL="postgresql://sentinelx:sentinelx_secret@localhost:5432/sentinelx?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS (comma-separated origins, Railway will set this)
# Include your Vercel frontend URL and any custom domains
CORS_ORIGIN=http://localhost:5173,https://sentinelx.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Cloudinary (optional - for logo uploads; falls back to local storage if not set)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Upload directory for local file storage (used when Cloudinary is not configured)
UPLOAD_DIR=uploads
